              "type": "string",
              "description": "Data final inclusiva (YYYY-MM-DD). Com período, posts ainda sem publicação agendada ficam fora."
            },
            "format": {
              "type": "string",
              "enum": [
                "design",
                "static",
                "carousel",
                "reel",
                "story",
                "video",
                "short",
                "article",
                "google_post"
              ],
              "description": "Formato publicável. design e static representam arte estática."
