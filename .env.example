# Este arquivo é a base pública do build Vite. Não coloque segredos de servidor
# nem service_role aqui. Inventário completo: docs/operations/ENVIRONMENT-INVENTORY.md

# Backend Supabase usado pelo frontend
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Obrigatória no build de produção. Define links absolutos e metadados sociais.
VITE_APP_PUBLIC_URL=https://app.example.com

# Opcionais. Quando vazios, os endpoints MCP são derivados de
# VITE_SUPABASE_URL/functions/v1/...
VITE_MCP_SERVER_URL=
VITE_MCP_OAUTH_METADATA_URL=

# Defina no ambiente de deploy quando o frontend usar os webhooks externos.
VITE_WEBHOOK_URL=https://automation.example.com/webhook

# Opcional. Sem o número internacional, CTAs de WhatsApp ficam ocultos.
VITE_SUPPORT_WHATSAPP_NUMBER=5511999999999

# Referência do runtime das Edge Functions. Configure estes nomes como secrets
# no projeto Supabase, nunca no arquivo carregado pelo Vite.
# MCP_RESOURCE_URL=https://api.example.com/functions/v1/mcp-server
# MCP_OAUTH_METADATA_URL=https://api.example.com/functions/v1/mcp-oauth-metadata
# MCP_AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# IA portátil OpenAI-compatible. AI_BASE_URL exige HTTPS fora de loopback.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=server-secret
# AI_MODEL=gpt-5-mini
# OPENAI_API_KEY=server-secret
# Hosts HTTPS exatos que o leitor de links do Studio pode buscar, separados
# por vírgula. Sem valor, apenas o host do próprio SUPABASE_URL é permitido.
# WORKSPACE_LINK_READER_ALLOWED_HOSTS=docs.example.com,help.example.com

# E-mail direto via Resend e webhooks portáteis Standard Webhooks.
# RESEND_API_KEY=server-secret
# RESEND_API_URL=https://api.resend.com
# SEND_EMAIL_HOOK_SECRET=server-secret
# SUPPRESSION_WEBHOOK_SECRET=server-secret
# EMAIL_PREVIEW_SECRET=server-secret
# Obrigatória nas Edge Functions que produzem links públicos, e-mail e metadata.
# APP_PUBLIC_URL=https://app.example.com
# EMAIL_LOGO_URL=https://app.example.com/logo-email.png
# EMAIL_SITE_NAME=AcelerIQ
# EMAIL_FROM_DOMAIN=example.com

# LOVABLE_API_KEY não é requisito. Use somente durante a janela de
# compatibilidade dos callbacks/preview antigos ou como último fallback de IA.
# LOVABLE_API_KEY=temporary-compatibility-secret

# Compatibilidade histórica do Ops descontinuado. Não ative em ambiente novo.
# OPS_BASE_URL=https://YOUR_OPS_REF.supabase.co/functions/v1
# OPS_RECEIVE_LEAD_URL=https://YOUR_OPS_REF.supabase.co/functions/v1/receive-lead
# OPS_RECEIVE_PORTAL_SYNC_URL=https://YOUR_OPS_REF.supabase.co/functions/v1/receive-portal-sync
# OPS_RECEIVE_URL=deprecated-use-OPS_RECEIVE_PORTAL_SYNC_URL
