[Unit]
Description=Aceleriq: intermediador dos grupos de cliente (uma rodada)
After=network-online.target mercurio-pilot-bridge.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aceleriq-intermediador
# previa = cada texto vai só ao WhatsApp do Almir. "grupos" (real) só com ok dele em palavras.
Environment=INTERMEDIADOR_MODO=previa
ExecStart=/opt/mercurio-pilot/node /opt/aceleriq-intermediador/intermediador.mjs
TimeoutStartSec=420
Nice=10
ProtectSystem=strict
# /root/.codex: a reserva do escritor (Codex) renova o login da conta do ChatGPT ali.
ReadWritePaths=/var/lib/aceleriq-intermediador /root/.codex
PrivateTmp=yes
NoNewPrivileges=yes
