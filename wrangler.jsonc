{
  // Front do painel na Cloudflare (Workers com arquivos estáticos). Ver docs/hospedagem/CLOUDFLARE-PAGES.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aceleriq-painel",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  // Endereço de teste *.workers.dev e um link de prévia por versão (conferir antes de virar).
  "workers_dev": true,
  "preview_urls": true,
  // aceleriq.online e www servidos por este Worker (Custom Domains; a Cloudflare cria o DNS).
  "routes": [
    { "pattern": "aceleriq.online", "custom_domain": true },
    { "pattern": "www.aceleriq.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Rotas do painel (/mesa, /proposta/:token...) devolvem o index.html.
    "not_found_handling": "single-page-application"
  }
}
