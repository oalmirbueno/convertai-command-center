{
  "name": "aceleriq-motor-codigo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Worker do motor de código (piloto na máquina da agência): puxa a fila motor_trabalhos, roda o opencode e publica a prévia.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "iniciar": "node --env-file-if-exists=.env worker.ts",
    "uma-vez": "node --env-file-if-exists=.env worker.ts --uma-vez",
    "teste-local": "node --env-file-if-exists=.env teste-ponta-a-ponta.ts",
    "teste-superpoderes": "node teste-superpoderes.ts",
    "teste-superpoderes-pago": "node --env-file-if-exists=.env teste-superpoderes.ts --pago",
    "atualizar-superpowers": "node scripts/atualizar-superpowers.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.310",
    "@opencode-ai/sdk": "1.18.33",
    "@supabase/supabase-js": "2.97.0",
    "opencode-ai": "1.18.33",
    "playwright-core": "1.63.0",
    "typescript": "5.8.3"
  }
}
