# Modelo do arquivo de chaves dos motores (frente MTR, 30/09/2026).
# Copie para %USERPROFILE%\.aceleriq\motores.env (FORA do repositório) e preencha.
# Alternativa sem arquivo: rode guardar-chaves.cmd (guarda nas variáveis do Windows).
# Nunca ponha este arquivo preenchido dentro do repositório nem mande por mensagem.

# Endereço do projeto (não é segredo; o script já usa este se ficar vazio).
SUPABASE_URL=https://jjjtkowvxemvituvywvf.supabase.co
# Supabase > Project Settings > API Keys > service_role (secret). Obrigatória para os dois workers.
SUPABASE_SERVICE_ROLE_KEY=
# Motor de código: pelo menos uma. A do OpenRouter cobre todos os modelos do catálogo.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Publicação do site na Vercel (opcional; sem ela o zip do site continua funcionando).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Opcionais do render: Chrome Headless Shell já baixado, ffmpeg fora do PATH, nome do worker.
RENDER_CHROME=
RENDER_FFMPEG=
RENDER_FFPROBE=
RENDER_HYPERFRAMES=
RENDER_GSAP=
RENDER_WORKER_NOME=
