[Unit]
Description=Aceleriq painel -> sessoes reais do Hermes (Central de Autonomia)
Wants=network-online.target
After=network-online.target hermes-gateway.service
Requires=hermes-gateway.service
ConditionPathExists=/opt/aceleriq-hermes-painel/painel_ponte.mjs

[Service]
Type=simple
User=aceleriq-tunnel
Group=aceleriq-tunnel
WorkingDirectory=/opt/aceleriq-hermes-painel
Environment=NODE_ENV=production
Environment=HERMES_API_URL=http://127.0.0.1:8642
Environment=PONTE_HOST=172.16.0.1
Environment=PONTE_PORT=9121
LoadCredentialEncrypted=hermes-api-key:/etc/credstore.encrypted/aceleriq-hermes-tunnel-hermes-api-key.cred
LoadCredentialEncrypted=painel-token:/etc/credstore.encrypted/aceleriq-painel-ponte-token.cred
ExecStart=/opt/aceleriq-hermes-node/bin/node /opt/aceleriq-hermes-painel/painel_ponte.mjs
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
